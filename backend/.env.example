# Optional: enables online conversational fallback through Omniroute.
# Leave blank to use the built-in offline fallback.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=gpt-4o-mini

# Local speech recognition settings.
WHISPER_MODEL=tiny.en
WHISPER_COMPUTE_TYPE=int8
